# Локальное мероприятие: статика + API/WebSocket на одном origin (:80).
# Запуск: MQ_ROOT=/path/to/repo caddy run --config deploy/caddy/Caddyfile.lan.event
# (скрипт event:start выставляет MQ_ROOT автоматически)

:80 {
  encode zstd gzip

  @health {
    path /healthz /readyz
  }
  handle @health {
    reverse_proxy 127.0.0.1:4000 {
      flush_interval -1
    }
  }

  @api path /api/* /socket.io* /media*
  handle @api {
    reverse_proxy 127.0.0.1:4000 {
      flush_interval -1
    }
  }

  handle /assets/* {
    root * {$MQ_ROOT}/client/dist
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @immutableStatic {
    path *.webp *.mp4 *.svg *.woff2 *.woff *.png *.jpg *.jpeg *.gif *.ico
  }
  handle @immutableStatic {
    root * {$MQ_ROOT}/client/dist
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @spaApp {
    path /admin /admin/* /q/* /p/* /s/* /report/* /403 /404
  }
  handle @spaApp {
    root * {$MQ_ROOT}/client/dist
    rewrite * /spa.html
    file_server
  }

  @wantMarkdown {
    header Accept *text/markdown*
  }
  handle @wantMarkdown {
    root * {$MQ_ROOT}/client/dist
    try_files {path}.md {path}/index.md
    header Content-Type "text/markdown; charset=utf-8"
    header Vary Accept
    file_server
  }

  handle {
    root * {$MQ_ROOT}/client/dist
    try_files {path} {path}/index.html
    header Vary Accept
    file_server
  }

  handle_errors {
    root * {$MQ_ROOT}/client/dist
    @err404 expression `{err.status_code} == 404`
    handle @err404 {
      @md404 {
        header Accept *text/markdown*
      }
      handle @md404 {
        rewrite * /404.md
        header Content-Type "text/markdown; charset=utf-8"
        header Vary Accept
        file_server
      }
      rewrite * /404.html
      file_server
    }
    @err500 expression `{err.status_code} == 500`
    rewrite @err500 /errors/500.html
    @err502 expression `{err.status_code} in [502, 503, 504]`
    rewrite @err502 /errors/502.html
    file_server
  }
}
