# Домен: подставьте через DOMAIN=meyou.site bash deploy/caddy/render-internet.sh | sudo tee /etc/caddy/Caddyfile
# либо задайте переменную DOMAIN окружению процесса Caddy.
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
  encode zstd gzip

  # /socket.io/* не матчит путь /socket.io — иначе long-polling попадает в SPA (index.html вместо JS).
  # /media/* — статика с backend (multer), не из client/dist.
  # healthz/readyz — отдельно: иначе try_files отдаёт SPA на эти пути.
  @health {
    path /healthz /readyz
  }
  handle @health {
    reverse_proxy 127.0.0.1:4000 {
      flush_interval -1
    }
  }

  @api path /api/* /socket.io* /media*
  handle @api {
    reverse_proxy 127.0.0.1:4000 {
      # Socket.IO (polling + upgrade): низкая задержка сброса буфера — иначе соединение часто рвётся на «half-open».
      flush_interval -1
    }
  }

  handle /assets/* {
    root * /opt/meyouquize/current/client/dist
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @immutableStatic {
    path *.webp *.mp4 *.svg *.woff2 *.woff *.png *.jpg *.jpeg *.gif *.ico
  }
  handle @immutableStatic {
    root * /opt/meyouquize/current/client/dist
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  # SPA-приложение (админка / игрок / проектор) — shell, не marketing soft-404.
  @spaApp {
    path /admin /admin/* /q/* /p/* /s/* /report/* /403 /404
  }
  handle @spaApp {
    root * /opt/meyouquize/current/client/dist
    rewrite * /spa.html
    file_server
  }

  # Markdown для агентов (Accept: text/markdown) — до HTML try_files.
  @wantMarkdown {
    header Accept *text/markdown*
  }
  handle @wantMarkdown {
    root * /opt/meyouquize/current/client/dist
    try_files {path}.md {path}/index.md
    header Content-Type "text/markdown; charset=utf-8"
    header Vary Accept
    file_server
  }

  handle {
    root * /opt/meyouquize/current/client/dist
    # / → index.html; /about → about/index.html; неизвестное → HTTP 404 (не spa.html)
    try_files {path} {path}/index.html
    header Vary Accept
    file_server
  }

  # Кастомные страницы для серверных ошибок: 404 — агент-friendly; 500/502 — backend.
  handle_errors {
    root * /opt/meyouquize/current/client/dist
    @err404 expression `{err.status_code} == 404`
    handle @err404 {
      @md404 {
        header Accept *text/markdown*
      }
      handle @md404 {
        rewrite * /404.md
        header Content-Type "text/markdown; charset=utf-8"
        header Vary Accept
        file_server
      }
      rewrite * /404.html
      file_server
    }
    @err500 expression `{err.status_code} == 500`
    rewrite @err500 /errors/500.html
    @err502 expression `{err.status_code} in [502, 503, 504]`
    rewrite @err502 /errors/502.html
    file_server
  }
}
