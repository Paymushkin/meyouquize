# Копируйте в .env.test для локальных integration/e2e тестов.
# НЕ используйте dev/prod БД — только meyouquize_test.

NODE_ENV=test
TEST_DATABASE=1
APP_NETWORK_MODE=lan
LOCAL_ADMIN_NO_AUTH=0
CLUSTER_WORKERS=1

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/meyouquize_test
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/meyouquize_test

# MEDIA_DIR задаётся автоматически в /tmp/meyouquize-test-*/media (vitest integration setup).
# Для ручного запуска server в test-режиме можно указать:
# MEDIA_DIR=/tmp/meyouquize-test/manual/media

ADMIN_LOGIN=admin
ADMIN_PASSWORD=test-admin-password

CLIENT_ORIGIN=http://127.0.0.1:5173
PORT=4000
